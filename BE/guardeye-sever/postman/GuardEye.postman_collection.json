         {
    "name": "Pause Device — Vô thời hạn",
    "event": [
      {
        "listen": "test",
        "script": {
          "exec": [
            "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
            "pm.test(\"isPaused === true\", () => {",
            "    const json = pm.response.json();",
            "    pm.expect(json.data.device.isPaused).to.eql(true);",
            "});",
            "pm.test(\"pausedUntil === null (Không có deadline)\", () => {",
            "    const json = pm.response.json();",
            "    pm.expect(json.data.device.pausedUntil).to.be.null;",
            "});"
          ],
          "type": "text/javascript"
        }
      }
    ],
    "request": {
      "method": "PATCH",
      "header": [
        {
          "key": "Authorization",
          "value": "Bearer {{accessToken}}",
          "type": "text"
        },
        {
          "key": "Content-Type",
          "value": "application/json",
          "type": "text"
        }
      ],
      "body": {
        "mode": "raw",
        "raw": "{}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      },
      "url": {
        "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}/pause",
        "host": ["{{baseUrl}}"],
        "path": ["api", "v1", "devices", "{{deviceId}}", "pause"]
      }
    }
  },
  {
    "name": "Pause Device — Có thời hạn (gần, để test auto-resume)",
    "event": [
      {
        "listen": "prerequest",
        "script": {
          "exec": [
            "// Tính toán thời điểm tương lai (hiện tại + 90 giây)",
            "const future = new Date(Date.now() + 90000).toISOString();",
            "// Lưu vào biến môi trường tạm thời để dùng trong Body",
            "pm.variables.set(\"pausedUntilNear\", future);"
          ],
          "type": "text/javascript"
        }
      },
      {
        "listen": "test",
        "script": {
          "exec": [
            "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
            "pm.test(\"isPaused === true\", () => {",
            "    const json = pm.response.json();",
            "    pm.expect(json.data.device.isPaused).to.eql(true);",
            "});",
            "pm.test(\"pausedUntil khớp với giá trị vừa gửi lên\", () => {",
            "    const json = pm.response.json();",
            "    const sentValue = pm.variables.get(\"pausedUntilNear\");",
            "    pm.expect(json.data.device.pausedUntil).to.eql(sentValue);",
            "});"
          ],
          "type": "text/javascript"
        }
      }
    ],
    "request": {
      "method": "PATCH",
      "header": [
        {
          "key": "Authorization",
          "value": "Bearer {{accessToken}}",
          "type": "text"
        },
        {
          "key": "Content-Type",
          "value": "application/json",
          "type": "text"
        }
      ],
      "body": {
        "mode": "raw",
        "raw": "{\n  \"pausedUntil\": \"{{pausedUntilNear}}\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      },
      "url": {
        "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}/pause",
        "host": ["{{baseUrl}}"],
        "path": ["api", "v1", "devices", "{{deviceId}}", "pause"]
      }
    }
  },
  {
    "name": "Resume Device — Thủ công",
    "event": [
      {
        "listen": "test",
        "script": {
          "exec": [
            "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
            "pm.test(\"Trạng thái Pause đã được reset hoàn toàn (cả 3 fields)\", () => {",
            "    const json = pm.response.json();",
            "    pm.expect(json.data.device.isPaused).to.eql(false);",
            "    pm.expect(json.data.device.pausedUntil).to.be.null;",
            "    pm.expect(json.data.device.pausedSince).to.be.null;",
            "});"
          ],
          "type": "text/javascript"
        }
      }
    ],
    "request": {
      "method": "PATCH",
      "header": [
        {
          "key": "Authorization",
          "value": "Bearer {{accessToken}}",
          "type": "text"
        }
      ],
      "url": {
        "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}/resume",
        "host": ["{{baseUrl}}"],
        "path": ["api", "v1", "devices", "{{deviceId}}", "resume"]
      }
    }
  },
  {
    "name": "Verify Auto-Resume",
    "event": [
      {
        "listen": "test",
        "script": {
          "exec": [
            "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
            "pm.test(\"Device đã được auto-resume bởi cron job\", () => {",
            "    const json = pm.response.json();",
            "    const currentDeviceId = pm.environment.get(\"deviceId\");",
            "    ",
            "    // Tìm device tương ứng trong mảng trả về",
            "    const device = json.data.find(d => d.id === currentDeviceId);",
            "    pm.expect(device, \"Không tìm thấy Device trong danh sách\").to.not.be.undefined;",
            "    ",
            "    // Xác nhận side-effect từ cron job",
            "    pm.expect(device.isPaused, \"Thiết bị vẫn đang bị pause, cron job chưa chạy hoặc có lỗi\").to.eql(false);",
            "    pm.expect(device.pausedUntil).to.be.null;",
            "    pm.expect(device.pausedSince).to.be.null;",
            "});"
          ],
          "type": "text/javascript"
        }
      }
    ],
    "request": {
      "method": "GET",
      "header": [
        {
          "key": "Authorization",
          "value": "Bearer {{accessToken}}",
          "type": "text"
        }
      ],
      "url": {
        "raw": "{{baseUrl}}/api/v1/devices",
        "host": ["{{baseUrl}}"],
        "path": ["api", "v1", "devices"]
      },
      "description": "Request này phải chạy CÁCH request \"Pause có thời hạn\" tối thiểu thời gian bằng [Chu kỳ cron job (1 phút) + Độ trễ pausedUntil (90s) = ~2.5 phút] để đảm bảo cron job đã quét ít nhất 1 lần.\n\nLý do: Không thể test trực tiếp cron job qua HTTP. Ta chỉ có thể test gián tiếp qua side-effect bằng cách kiểm tra sự thay đổi trạng thái isPaused dưới Database qua API GET này."
    }
  }
      ]
    },
    {
      "name": "Agent",
      "description": "Các endpoint dành riêng cho Agent (desktop client).\nXác thực bằng X-Device-Token header, KHÔNG dùng Bearer JWT.",
      "item": [
        {
          "name": "Sync Events",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gán deviceToken vào header trước khi gửi",
                  "pm.request.headers.add({",
                  "  key: 'X-Device-Token',",
                  "  value: pm.environment.get('deviceToken')",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"success = true\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "});",
                  "pm.test(\"savedCount là số\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.savedCount).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Device-Token",
                "value": "{{deviceToken}}",
                "type": "text",
                "description": "Token định danh thiết bị — lấy từ response Create Device"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceToken\": \"{{deviceToken}}\",\n  \"sentAt\": \"{{$isoTimestamp}}\",\n  \"eventCount\": 2,\n  \"events\": [\n    {\n      \"type\": \"window\",\n      \"timestamp\": \"2026-06-10T09:00:00.000Z\",\n      \"title\": \"YouTube - Google Chrome\",\n      \"processName\": \"chrome.exe\",\n      \"isIncognito\": false\n    },\n    {\n      \"type\": \"history\",\n      \"timestamp\": \"2026-06-10T09:00:00.000Z\",\n      \"url\": \"https://www.youtube.com/watch?v=dQw4w9WgXcQ\",\n      \"title\": \"Rick Astley - Never Gonna Give You Up\",\n      \"browser\": \"chrome\",\n      \"visitTime\": \"2026-06-10T08:58:00.000Z\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/agent/sync",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agent", "sync"]
            },
            "description": "Agent gửi batch events lên server.\n\n**Header bắt buộc:** `X-Device-Token: <deviceToken>`\n\n**Validation:**\n- `eventCount` phải khớp chính xác với `events.length`\n- Mỗi event phải có đúng `type` = `\"window\"` hoặc `\"history\"`\n- `timestamp`, `sentAt`, `visitTime` phải là ISO 8601\n- `browser` chỉ nhận: `\"chrome\"`, `\"edge\"`, `\"unknown\"`\n\n**Response thành công (200):**\n```json\n{\n  \"success\": true,\n  \"message\": \"Đồng bộ thành công: đã lưu 2 sự kiện\",\n  \"data\": {\n    \"success\": true,\n    \"savedCount\": 2,\n    \"windowCount\": 1,\n    \"historyCount\": 1\n  }\n}\n```"
          },
          "response": [
            {
              "name": "200 - Sync thành công",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-Device-Token", "value": "abc-device-token-123" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"deviceToken\": \"abc-device-token-123\",\n  \"sentAt\": \"2026-06-10T09:00:00.000Z\",\n  \"eventCount\": 1,\n  \"events\": [\n    {\n      \"type\": \"window\",\n      \"timestamp\": \"2026-06-10T09:00:00.000Z\",\n      \"title\": \"YouTube - Google Chrome\",\n      \"processName\": \"chrome.exe\",\n      \"isIncognito\": false\n    }\n  ]\n}"
                },
                "url": "{{baseUrl}}/api/v1/agent/sync"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"statusCode\": 200,\n  \"message\": \"Đồng bộ thành công: đã lưu 1 sự kiện\",\n  \"data\": {\n    \"success\": true,\n    \"savedCount\": 1,\n    \"windowCount\": 1,\n    \"historyCount\": 0,\n    \"message\": \"Đồng bộ thành công: đã lưu 1 sự kiện\"\n  }\n}"
            },
            {
              "name": "400 - eventCount mismatch",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-Device-Token", "value": "abc-device-token-123" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"deviceToken\": \"abc-device-token-123\",\n  \"sentAt\": \"2026-06-10T09:00:00.000Z\",\n  \"eventCount\": 5,\n  \"events\": []\n}"
                },
                "url": "{{baseUrl}}/api/v1/agent/sync"
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": false,\n  \"message\": \"Dữ liệu không hợp lệ\",\n  \"errors\": {\n    \"eventCount\": \"eventCount không khớp với số lượng events thực tế\"\n  }\n}"
            },
            {
              "name": "401 - Device token không hợp lệ",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-Device-Token", "value": "invalid-token" }
                ],
                "body": { "mode": "raw", "raw": "{}" },
                "url": "{{baseUrl}}/api/v1/agent/sync"
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": false,\n  \"message\": \"Device token không hợp lệ\"\n}"
            }
          ]
        },
        {
          "name": "Get Agent Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Có trường paused\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('paused');",
                  "  pm.expect(json.data.paused).to.be.a('boolean');",
                  "});",
                  "// Tự động lưu trạng thái pause để dùng trong script Agent",
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  pm.environment.set('agentPaused', json.data.paused);",
